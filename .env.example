# Google PageSpeed Insights API Key
PAGESPEED_API_KEY=your_pagespeed_api_key

# Google OAuth Credentials (for GTM API access)
GTM_CLIENT_ID=your_gtm_client_id.apps.googleusercontent.com
GTM_CLIENT_SECRET=your_gtm_client_secret
ENTERPRISE_TOKEN=your_gtm_enterprise_refresh_token
Riddhi_TOKEN=your_optional_additional_token
PREMIUM_TOKEN=your_optional_additional_token
DATA_TOKEN=your_optional_additional_token

# Gmail API Credentials
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
Riddhi_GMAIL_TOKEN=your_gmail_refresh_token

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Server-side Firebase config aliases
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
